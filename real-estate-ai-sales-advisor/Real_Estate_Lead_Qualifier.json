    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.recentMessages = staticData.recentMessages || {};\n\nconst phone = String($json.customer_phone || '').trim();\nconst message = String($json.customer_message || '').trim().toLowerCase();\n\n// Agar phone ya message empty hai, toh pass hone do (filter aage handle karega)\nif (!phone || !message) {\n  return [$input.item];\n}\n\nconst key = `${phone}:${message}`;\nconst now = Date.now();\nconst lastSeenTime = staticData.recentMessages[key] || 0;\n\n// Cleanup: 60 second se purani entries delete kar do memory clean rakhne ke liye\nfor (const k in staticData.recentMessages) {\n  if (now - staticData.recentMessages[k] > 60000) {\n    delete staticData.recentMessages[k];\n  }\n}\n\n// Agar same phone number se same message pichle 10 seconds ke andar aaya hai:\nif (now - lastSeenTime < 10000) {\n  // Yeh 100% duplicate / retry hai! Isko yahi turant drop karo!\n  return [];\n}\n\n// Pehli baar aaya hai: Record time and pass to AI!\nstaticData.recentMessages[key] = now;\nreturn [$input.item];"
      },
